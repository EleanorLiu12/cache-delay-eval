.DS_Store

# Local paper drafts kept outside the remote repository.
paper/

# Local environments and tooling.
.venv/
.venv-vllm-metal/
.tools/

# Python build and test artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Keep raw measurements in version control; ignore only scratch reruns.
results/scratch-*

# Downloaded public traces are refetched and hash-checked by scripts/fetch_*.py.
data/
# Per-request CPU metrics are recomputed from the pinned trace in seconds.
results/qwen-trace-a-*/requests-*.jsonl

# Disposable exports, dry-run plans and scratch files.
output/
tmp/
results/pattern-plan*/
