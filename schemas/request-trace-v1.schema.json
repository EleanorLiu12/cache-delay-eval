{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cache-delay/request-trace-v1.schema.json",
  "title": "Cache-delay request trace JSONL record",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/request"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["type", "schema_version", "trace_id", "created_at", "time_unit", "source"],
      "properties": {
        "type": {"const": "trace_meta"},
        "schema_version": {"enum": ["1.0", "1.1"]},
        "trace_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "time_unit": {"const": "ms"},
        "source": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "block_size": {"type": "integer", "minimum": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["type", "request_id", "arrival_time_ms", "output_tokens"],
      "properties": {
        "type": {"const": "request"},
        "request_id": {"type": "string", "minLength": 1},
        "arrival_time_ms": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 1},
        "prompt": {"type": "string", "minLength": 1},
        "token_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "block_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {"type": "integer", "minimum": 0},
              {"type": "string", "minLength": 1}
            ]
          }
        },
        "prompt_tokens": {"type": "integer", "minimum": 1},
        "session_id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "parent_request_id": {"type": "string", "minLength": 1},
        "prefix_group": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      },
      "oneOf": [
        {"required": ["prompt"]},
        {"required": ["token_ids"]},
        {"required": ["block_hashes", "prompt_tokens"]}
      ],
      "additionalProperties": false
    }
  }
}
